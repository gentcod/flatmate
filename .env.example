# Copy to .env and fill in. Every value is optional; see internal/util/config.go.
ADDR=:8080
DB_PATH=flatmate.db
WEIGHTS_PATH=weights.yaml
WEB_DIR=web
MIGRATIONS_DIR=migrations
SEED_PATH=seeds/global.json
FLATMATE_SESSION_KEY=
# 1 = always Secure cookies, 0 = never; empty = secure unless serving on localhost.
FLATMATE_COOKIE_SECURE=
FLATMATE_MODEL_ENDPOINT=
FLATMATE_MODEL_NAME=
FLATMATE_MODEL_TOKEN=
# legacy = server-rendered pages, spa = serve client/dist (needs make client-build).
FLATMATE_UI=legacy
CLIENT_DIST=client/dist
